{
  "name": "field-notes-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "TAILWIND_MODE=watch next dev",
    "dev:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles/output.css --watch",
    "build": "next build",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles/output.css --minify",
    "start": "next start",
    "lint": "eslint . --max-warnings 10",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:rebuild": "docker-compose -f docker-compose.dev.yml up --build --force-recreate",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "test:e2e": "playwright test",
    "mock-server": "NODE_NO_WARNINGS=1 tsx e2e/mock-server.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "dev:test": "NODE_NO_WARNINGS=1 BACKEND_URL=http://localhost:5555 NEXT_PUBLIC_API_URL=http://localhost:5555 NEXTAUTH_URL=http://localhost:3000 NEXTAUTH_SECRET=test-secret-for-e2e-tests UNSAFE_EVAL=true next dev",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "^3.14.0",
    "@tiptap/extension-image": "^3.14.0",
    "@tiptap/extension-link": "^3.14.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "cheerio": "^1.1.2",
    "cookie": "^1.1.1",
    "dompurify": "^3.2.5",
    "he": "^1.2.0",
    "isomorphic-dompurify": "^2.35.0",
    "jwt-decode": "^4.0.0",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-infinite-scroll-component": "^6.1.1",
    "react-spinners": "^0.17.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@next/eslint-plugin-next": "^16.1.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/express": "^5.0.6",
    "@types/he": "^1.2.3",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "express": "^5.2.1",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.18"
  }
}

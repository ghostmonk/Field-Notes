{
  "name": "field-notes-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:docker": "TAILWIND_MODE=watch next dev",
    "dev:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles/output.css --watch",
    "build": "next build",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./public/styles/output.css --minify",
    "start": "next start",
    "lint": "eslint . --max-warnings 10",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:dev:rebuild": "docker-compose -f docker-compose.dev.yml up --build --force-recreate",
    "clean": "rm -rf .next && rm -rf node_modules/.cache",
    "test:e2e": "playwright test",
    "mock-server": "NODE_NO_WARNINGS=1 tsx e2e/mock-server.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "dev:test": "echo 'Starting Next.js dev server (Turbopack compile may take 30-60s)...' && NODE_NO_WARNINGS=1 BACKEND_URL=http://localhost:5555 NEXT_PUBLIC_API_URL=http://localhost:5555 NEXTAUTH_URL=http://localhost:3000 NEXTAUTH_SECRET=test-secret-for-e2e-tests next dev --turbopack",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@headless-tree/core": "^1.8.0",
    "@headless-tree/react": "^1.8.0",
    "@react-pdf/renderer": "^4.9.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "docx": "^9.14.0",
    "dompurify": "^3.4.17",
    "file-saver": "^2.0.5",
    "he": "^2.0.0",
    "isomorphic-dompurify": "^4.6.0",
    "lucide-react": "^1.61.0",
    "medium-zoom": "^1.1.2",
    "next": "^16.4.3",
    "next-auth": "^4.24.15",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-infinite-scroll-component": "^7.2.1",
    "react-spinners": "^0.17.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/he": "^1.2.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.3.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.18"
  }
}
